source 'https://rubygems.org'

# The site is built on Ruby 2.7 (jekyll-assets 3.x does not run on Ruby 3).
# The upper bounds below keep the lockfile on releases that still support 2.7.

gem 'jekyll', '~> 3.10'
gem 'jekyll-assets', '~> 3.0'
gem 'jekyll-paginate'
gem 'kramdown-parser-gfm'
gem 'uglifier'
gem 's3_website'

gem 'html-proofer', '~> 3.19'

# Ruby 2.7 compatibility pins for transitive dependencies
gem 'activesupport', '~> 5.2'
gem 'sprockets', '~> 3.7'
gem 'nokogiri', '~> 1.15.6'
gem 'zeitwerk', '~> 2.6.0'
gem 'public_suffix', '< 6'
gem 'i18n', '~> 1.14.0'
gem 'minitest', '<= 5.26.1'
